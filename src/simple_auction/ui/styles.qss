/* Values like $accent are filled in from theme.py. */

QWidget {
    color: $text;
    font-size: 13px;
}

QMainWindow,
QWidget#content,
QSplitter#content,
QWidget#scrollBody {
    background: $bg;
}

QToolTip {
    background: $surface;
    color: $text;
    border: 1px solid $border;
    padding: 4px 6px;
}

QSplitter::handle {
    background: $bg;
}

QSplitter::handle:hover {
    background: $accent_soft;
}

QWidget#workspaceHeader {
    background: $surface;
    border-bottom: 1px solid $border;
}

QDoubleSpinBox {
    background: $field;
    border: 1px solid $border;
    border-radius: 6px;
    padding: 7px 4px;
    selection-background-color: $accent;
}

/* ---- Shipping ----------------------------------------------------- */

QFrame#shippingEmpty {
    background: $surface;
    border: 2px dashed $border;
    border-radius: 12px;
}

QFrame#shippingEmpty[state="dragging"] {
    background: $accent_soft;
    border-color: $accent;
}

QLabel#shippingEmptyTitle {
    font-size: 22px;
    font-weight: 700;
}

QLabel#shippingStepNumber {
    background: $accent_soft;
    color: $accent;
    border-radius: 13px;
    font-weight: 700;
}

QLabel#shippingStepTitle {
    font-weight: 600;
}

QLabel#shippingStep {
    color: $muted;
    padding: 5px 10px;
    border-radius: 12px;
}

QLabel#shippingStep[state="active"] {
    background: $accent_soft;
    color: $accent;
    font-weight: 600;
}

QLabel#shippingStep[state="done"] {
    color: $text;
}

QLabel#shippingStepDivider {
    color: $border;
}

QLabel#shippingPill {
    padding: 3px 10px;
    border-radius: 10px;
    font-size: 12px;
    font-weight: 600;
    background: $hover;
    color: $muted;
}

QLabel#shippingPill[state="ready"],
QLabel#shippingPill[state="done"] {
    background: $accent_soft;
    color: $accent;
}

QLabel#shippingPill[state="attention"] {
    border: 1px solid $danger;
    background: transparent;
    color: $danger;
}

QProgressBar#shippingProgress {
    background: $hover;
    border: none;
    border-radius: 3px;
}

QProgressBar#shippingProgress::chunk {
    background: $accent;
    border-radius: 3px;
}

QFrame#shippingActionBar {
    background: $surface;
    border: 1px solid $border;
    border-radius: 10px;
}

QLabel#shippingCheck {
    color: $muted;
}

QLabel#shippingCheck[state="error"] {
    color: $danger;
}

QLabel#shippingCheck[state="ok"],
QLabel#shippingCheck[state="done"] {
    color: $accent;
    font-weight: 600;
}

QLabel#shippingAddressText {
    font-size: 14px;
}

QFrame#shippingQueue,
QFrame#shippingCard,
QFrame#shippingFooter {
    background: $surface;
    border: 1px solid $border;
    border-radius: 10px;
}

QLabel#shippingBuyerTitle {
    font-size: 24px;
    font-weight: 700;
}

QLabel#shippingCardTitle {
    font-size: 15px;
    font-weight: 600;
}

QLabel#shippingFieldLabel {
    font-size: 13px;
    font-weight: 600;
}

QFrame#shippingWeightBox {
    background: $field;
    border: 1px solid $border;
    border-radius: 8px;
}

QLineEdit#shippingWeight {
    background: transparent;
    border: none;
    padding: 0;
    font-size: 28px;
    font-weight: 600;
}

QLabel#shippingWeightUnit {
    font-size: 20px;
    color: $muted;
}

QLineEdit#shippingNumber {
    font-size: 16px;
}

QTableWidget#shippingBuyers {
    background: transparent;
    border: none;
    outline: 0;
}

QTableWidget#shippingBuyers::item {
    padding: 4px;
    border-bottom: 1px solid $border;
}

QTableWidget#shippingBuyers::item:selected {
    background: $accent_soft;
    color: $text;
}

QListWidget#shippingLots {
    background: transparent;
    border: none;
}

QListWidget#shippingLots::item {
    padding: 7px 0;
}

QFrame#shippingExport {
    background: $accent_soft;
    border: 1px solid $accent;
    border-radius: 8px;
}

QWidget#content QPushButton#primary:disabled {
    background: $surface;
    color: $muted;
    border-color: $border;
}

/* ---- Sidebar ------------------------------------------------------- */

QFrame#sidebar {
    background: $sidebar;
    border-right: 1px solid $border;
}

QLabel#appName {
    font-size: 15px;
    font-weight: 700;
}

QLabel#sectionLabel {
    color: $muted;
    font-size: 11px;
    font-weight: 600;
}

QTreeWidget#lotTree {
    background: transparent;
    border: none;
    outline: 0;
}

/* ---- Buttons ------------------------------------------------------- */

QPushButton {
    background: $surface;
    border: 1px solid $border;
    border-radius: 6px;
    padding: 7px 14px;
}

QPushButton:hover {
    background: $hover;
}

QPushButton:pressed {
    background: $border;
}

QPushButton#primary {
    background: $accent;
    color: $accent_text;
    border: 1px solid $accent;
    font-weight: 600;
}

QPushButton#primary:hover {
    background: $accent_hover;
    border-color: $accent_hover;
}

QPushButton#ghost {
    background: transparent;
    border: none;
    color: $muted;
    text-align: left;
    padding: 8px 10px;
}

QPushButton#ghost:hover {
    background: $hover;
    color: $text;
}

QPushButton#link {
    background: transparent;
    border: none;
    color: $accent;
    padding: 2px 4px;
}

QPushButton#link:hover {
    color: $accent_hover;
    text-decoration: underline;
}

/* ---- Lot editor ---------------------------------------------------- */

QLabel#lotTitle {
    font-size: 26px;
    font-weight: 700;
}

QLabel#saveState {
    color: $muted;
    font-size: 12px;
}

QLabel#saveState[state="error"] {
    color: $danger;
    font-weight: 600;
}

QLabel#subtitle,
QLabel#hint {
    color: $muted;
}

QLabel#emptyTitle {
    font-size: 18px;
    font-weight: 600;
}

QFrame#card {
    background: $surface;
    border: 1px solid $border;
    border-radius: ${radius}px;
}

QLabel#cardTitle {
    font-size: 14px;
    font-weight: 600;
}

QLabel#fieldLabel {
    color: $muted;
    font-size: 12px;
    font-weight: 600;
}

QLabel#charCount {
    color: $muted;
    font-size: 11px;
}

QLabel#charCount[over="true"] {
    color: $danger;
    font-weight: 600;
}

QLineEdit,
QPlainTextEdit,
QComboBox {
    background: $field;
    border: 1px solid $border;
    border-radius: 6px;
    padding: 7px 9px;
    selection-background-color: $accent;
    selection-color: $accent_text;
}

QLineEdit:hover,
QPlainTextEdit:hover,
QComboBox:hover {
    border-color: $muted;
}

QLineEdit:focus,
QPlainTextEdit:focus,
QComboBox:focus {
    border: 1px solid $accent;
}

QComboBox::drop-down {
    border: none;
    width: 28px;
}

QComboBox::down-arrow {
    image: url($chevron);
    width: 12px;
    height: 12px;
}

QComboBox QAbstractItemView {
    background: $surface;
    border: 1px solid $border;
    padding: 4px;
    outline: 0;
    selection-background-color: $accent_soft;
    selection-color: $text;
}

QListWidget#photos {
    background: $field;
    border: 1px dashed $border;
    border-radius: ${radius}px;
    padding: 6px;
    outline: 0;
}

QListWidget#photos::item {
    border-radius: 6px;
    padding: 4px;
}

QListWidget#photos::item:selected {
    background: $accent_soft;
    color: $text;
}

QTableWidget#linksTable {
    background: $field;
    border: 1px solid $border;
    border-radius: 6px;
    gridline-color: $border;
    selection-background-color: $accent_soft;
    selection-color: $text;
}

QHeaderView::section {
    background: $surface;
    color: $muted;
    border: none;
    border-bottom: 1px solid $border;
    padding: 4px 6px;
    font-weight: 600;
}

/* ---- Research panel ------------------------------------------------ */

QFrame#researchPanel {
    background: $surface;
    border-left: 1px solid $border;
}

QTextBrowser#transcript {
    background: transparent;
    border: none;
    selection-background-color: $accent;
    selection-color: $accent_text;
}

QPushButton:checked {
    background: $accent_soft;
    border-color: $accent;
}

QPushButton#ghostBordered {
    background: transparent;
    border: 1px solid $border;
    border-radius: 6px;
    padding: 7px 14px;
}

/* ---- Menus, scrollbars, status bar --------------------------------- */

QMenu {
    background: $surface;
    border: 1px solid $border;
    border-radius: ${radius}px;
    padding: 4px;
}

QMenu::item {
    padding: 6px 22px 6px 12px;
    border-radius: 4px;
}

QMenu::item:selected {
    background: $accent_soft;
    color: $text;
}

QMenu::separator {
    height: 1px;
    background: $border;
    margin: 4px 6px;
}

QScrollArea {
    border: none;
    background: transparent;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px;
}

QScrollBar::handle:vertical,
QScrollBar::handle:horizontal {
    background: $border;
    border-radius: 3px;
    min-height: 30px;
    min-width: 30px;
}

QScrollBar::handle:hover {
    background: $muted;
}

QScrollBar::add-line,
QScrollBar::sub-line,
QScrollBar::add-page,
QScrollBar::sub-page {
    width: 0;
    height: 0;
    background: none;
}

QStatusBar {
    background: $bg;
    color: $muted;
    border-top: 1px solid $border;
}

/* ---- Settings ----------------------------------------------------- */

QTabWidget#settingsTabs::pane {
    border: none;
}

QTabWidget#settingsTabs QTabBar::tab {
    background: $bg;
    color: $muted;
    padding: 10px 18px;
    border-bottom: 2px solid transparent;
}

QTabWidget#settingsTabs QTabBar::tab:selected {
    color: $text;
    border-bottom-color: $accent;
}

QTabWidget#settingsTabs QTabBar::tab:hover {
    background: $accent_soft;
}

QFrame#settingsSection {
    background: $surface;
    border: 1px solid $border;
    border-radius: 10px;
}

QLabel#settingsSectionTitle {
    font-size: 15px;
    font-weight: 600;
}

QDialog#settingsDialog QPushButton:disabled {
    color: $muted;
    background: $bg;
    border-color: $border;
}
